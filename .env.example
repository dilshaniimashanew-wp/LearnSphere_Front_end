# --- Local development -------------------------------------------------------
# Base URL of the LearnSphere API (no trailing slash). In development the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public URL of this web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows quick-fill buttons for the seeded demo accounts on the login page
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# --- Production (Vercel) -----------------------------------------------------
# The browser talks only to this app; the app forwards /api/v1/* to the API. This keeps login cookies first-party.
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_PROXY_TARGET=https://your-api-project.vercel.app
#   PROXY_SECRET=<same random value (16+ chars) as the API's PROXY_SECRET>
